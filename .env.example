# Set these server-only values in Vercel > Settings > Environment Variables.
# Never use NEXT_PUBLIC_ for any of them, and never commit real credentials.
# Authenticated LWS SMTP; use the mailbox password, not the LWS customer password.
SMTP_HOST=mail.e-xperteo.com
SMTP_PORT=465
SMTP_USER=contact@e-xperteo.com
SMTP_PASSWORD=
# A single recipient mailbox; sender must match the authenticated SMTP user.
LEADS_TO_EMAIL=contact@e-xperteo.com
LEADS_FROM_EMAIL=contact@e-xperteo.com
# Shared abuse counters only; no form messages are stored in Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate a random secret of at least 32 characters, e.g. 32 random bytes in hex.
RATE_LIMIT_SECRET=
