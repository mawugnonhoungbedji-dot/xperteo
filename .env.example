# Set these server-only values in Vercel > Settings > Environment Variables.
# Never use NEXT_PUBLIC_ for any of them, and never commit real credentials.
RESEND_API_KEY=
# A single recipient mailbox and a plain sender address on a Resend-verified domain.
LEADS_TO_EMAIL=contact@e-xperteo.com
LEADS_FROM_EMAIL=
# Shared abuse counters only; no form messages are stored in Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate a random secret of at least 32 characters, e.g. 32 random bytes in hex.
RATE_LIMIT_SECRET=
